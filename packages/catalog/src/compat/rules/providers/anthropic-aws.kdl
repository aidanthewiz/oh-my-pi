// Claude Platform on AWS exposes Anthropic model ids with provider-specific effort ladders.

provider "anthropic-aws" {
	models "claude-fable-5" "claude-opus-4-7" "claude-opus-4-8" "claude-sonnet-5" {
		thinking-effort-map {
			minimal "low"
			low "medium"
			medium "high"
			high "xhigh"
			xhigh "max"
		}
	}
	models "claude-opus-4-6" {
		thinking-effort-map {
			minimal "low"
			xhigh "max"
		}
	}
	models "claude-sonnet-4-6" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-effort-map {
			minimal "low"
		}
	}
	models "claude-opus-5" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
}
