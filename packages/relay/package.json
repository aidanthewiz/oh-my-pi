{
  "type": "module",
  "name": "@oh-my-pi/relay",
  "version": "0.2.4",
  "private": true,
  "description": "Content-blind WebSocket relay and encrypted share store for Coreforce agent collaboration",
  "main": "./src/main.ts",
  "scripts": {
    "build": "bun build src/main.ts --target=bun --minify --outfile=dist/server.js && bun build src/jwks-mirror.ts --target=bun --minify --outfile=dist/jwks-mirror.js",
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
    "lint": "oxlint .",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "@oh-my-pi/pi-wire": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
