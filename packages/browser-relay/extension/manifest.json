{
	"manifest_version": 3,
	"name": "Coreforge Browser Relay",
	"version": "0.2.0",
	"description": "Coreforge in Chrome: a side panel for sessions that drive your tabs through the local Coreforge relay.",
	"author": "Stencil Labs, Inc.",
	"minimum_chrome_version": "120",
	"permissions": [
		"debugger",
		"tabs",
		"tabGroups",
		"storage",
		"unlimitedStorage",
		"alarms",
		"scripting",
		"downloads",
		"sidePanel",
		"nativeMessaging",
		"notifications",
		"offscreen"
	],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js"
	},
	"side_panel": {
		"default_path": "panel.html"
	},
	"action": {
		"default_title": "Coreforge Browser Relay",
		"default_icon": {
			"16": "icons/coreforge.png",
			"32": "icons/coreforge.png",
			"48": "icons/coreforge.png",
			"128": "icons/coreforge.png"
		}
	},
	"icons": {
		"16": "icons/coreforge.png",
		"32": "icons/coreforge.png",
		"48": "icons/coreforge.png",
		"128": "icons/coreforge.png"
	},
	"commands": {
		"toggle-side-panel": {
			"description": "Open Coreforge",
			"suggested_key": {
				"default": "Ctrl+E",
				"mac": "Command+E"
			}
		}
	}
}
